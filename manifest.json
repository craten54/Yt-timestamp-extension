{
    "manifest_version": 3,
    "name": "YT VOD Timestamp Generator",
    "version": "1.0",
    "description": "Generate AI timestamps and download transcripts from YouTube VODs with one click.",
    "permissions": [
        "activeTab",
        "scripting",
        "downloads",
        "storage"
    ],
    "host_permissions": [
        "https://*.youtube.com/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "assets/icon-16.png",
            "48": "assets/icon-48.png",
            "128": "assets/icon-128.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    }
}